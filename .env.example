# ==============================================================================
# CAFFÈ & TÈ — ALL DAY CAFE | ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development
# ==============================================================================

# App & URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL via Prisma)
# If unreachable in local dev, the app falls back to the seeded in-memory store
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caffe_te_dev?schema=public"

# Authentication & RBAC Session Secret
AUTH_SECRET="replace-with-32-byte-hex-secret-in-production"

# Sanity Studio & Headless CMS (Cloud SSO + 2FA Admin)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-01"
NEXT_PUBLIC_SANITY_STUDIO_URL="https://your_sanity_project_id.sanity.studio"
SANITY_API_WRITE_TOKEN="your_sanity_write_token"

# Payment Providers (Razorpay primary, Stripe optional)
PAYMENT_PROVIDER="razorpay" # "razorpay" | "stripe"
PAYMENT_TEST_MODE="true"
ALLOW_COD="true"

RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_razorpay_test_secret"

STRIPE_PUBLIC_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_stripe_test_secret"

# Kitchen Billing / POS Integration
# Options: "manual" | "api" | "middleware" | "bridge"
POS_ADAPTER="manual"
POS_API_BASE_URL="https://pos.example.invalid/api/v1"
POS_API_KEY="pos_api_key_placeholder"
POS_BRIDGE_TOKEN="pos_bridge_pull_secret_placeholder"

# Notifications (Email / SMS / WhatsApp)
NOTIFICATION_PROVIDER_EMAIL="stub" # "stub" | "resend" | "ses"
RESEND_API_KEY="re_placeholder"
NOTIFICATION_FROM_EMAIL="no-reply@caffete.local"

NOTIFICATION_PROVIDER_SMS="stub" # "stub" | "msg91" | "twilio"
MSG91_AUTH_KEY="msg91_placeholder"

NOTIFICATION_PROVIDER_WHATSAPP="stub" # "stub" | "whatsapp_cloud" | "twilio"
WHATSAPP_API_TOKEN="wa_placeholder"
NEXT_PUBLIC_WHATSAPP_NUMBER="910000000000"

# Google Business Profile / Reviews
GOOGLE_PLACES_API_KEY="gplaces_placeholder"
GOOGLE_PLACE_ID="ChIJ_placeholder"

# Spam Protection (Cloudflare Turnstile / reCAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Analytics (Consent-aware GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

